<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1C1B1F"
            android:elevation="4dp"
            android:translationZ="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivToolbarLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logotfg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Aprende &amp; Aprueba"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivToolbarLogo"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="90dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavContainerWrapper"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottomNavContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bottom_nav_background"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Nav Item: Apuntes -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnNavApuntes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNavPruebas"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circleApuntes"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconoapuntes"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#FFFFFF" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatApuntes"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconoapuntes"
                        app:layout_constraintBottom_toTopOf="@id/textApuntes"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:tint="#AAAAAA" />

                    <TextView
                        android:id="@+id/textApuntes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apuntes"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iconFlatApuntes" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Nav Item: Pruebas -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnNavPruebas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNavResumenes"
                    app:layout_constraintStart_toEndOf="@id/btnNavApuntes">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circlePruebas"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconopruebas"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#FFFFFF" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatPruebas"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconopruebas"
                        app:layout_constraintBottom_toTopOf="@id/textPruebas"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:tint="#AAAAAA" />

                    <TextView
                        android:id="@+id/textPruebas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pruebas"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iconFlatPruebas" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Nav Item: Resumenes -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnNavResumenes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnNavPruebas">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circleResumenes"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconoresumenes"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#FFFFFF" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatResumenes"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconoresumenes"
                        app:layout_constraintBottom_toTopOf="@id/textResumenes"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:tint="#AAAAAA" />

                    <TextView
                        android:id="@+id/textResumenes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resúmenes"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iconFlatResumenes" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1C1B1F"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemRippleColor="#33A020F0"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetStart="12dp"
        app:itemTextColor="@color/nav_item_color_state"
        app:menu="@menu/nav_menu"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.LargeComponent"
        app:theme="@style/Widget.App.NavigationView" />

</androidx.drawerlayout.widget.DrawerLayout>