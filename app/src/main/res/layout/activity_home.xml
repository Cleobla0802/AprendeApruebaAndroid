<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1C1B1F"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/logotfg"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprende &amp; Aprueba"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/bottomNavContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:background="@drawable/bottom_nav_background"
                android:elevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/btnNavApuntes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circleApuntes"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconoapuntes"
                            app:tint="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatApuntes"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconoapuntes"
                        android:visibility="visible"
                        app:tint="#AAAAAA"/>

                    <TextView
                        android:id="@+id/textApuntes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apuntes"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNavPruebas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circlePruebas"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconopruebas"
                            app:tint="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatPruebas"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconopruebas"
                        android:visibility="visible"
                        app:tint="#AAAAAA"/>

                    <TextView
                        android:id="@+id/textPruebas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pruebas"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNavResumenes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/circleResumenes"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bottom_nav_center_button"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/iconoresumenes"
                            app:tint="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iconFlatResumenes"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/iconoresumenes"
                        android:visibility="visible"
                        app:tint="#AAAAAA"/>

                    <TextView
                        android:id="@+id/textResumenes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resúmenes"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>