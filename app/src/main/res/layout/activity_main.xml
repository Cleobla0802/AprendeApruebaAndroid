<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <!-- Forma curva superior izquierda (púrpura) -->
    <View
        android:id="@+id/curve_top_left"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:background="@drawable/vector1"
        app:layout_constraintEnd_toStartOf="@id/center_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Forma curva inferior derecha-->
    <View
        android:id="@+id/curve_bottom_right"
        android:layout_width="350dp"
        android:layout_height="450dp"
        android:background="@drawable/vector2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/center_content" />

    <!-- Contenido central (centrado vertical/horizontal) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/center_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo A&A (círculo con fondo verde texturizado) -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="150dp"
            android:layout_height="200dp"
            android:layout_marginBottom="70dp"
            android:cropToPadding="false"
            android:src="@drawable/logotfg"
            app:layout_constraintBottom_toTopOf="@id/text_intro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Texto introductorio -->
        <TextView
            android:id="@+id/text_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Aprende Aprueba te ayudará a aprobar este año de la forma más fácil y rápida jamás vista"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toTopOf="@id/title_slogan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo" />

        <!-- Título resaltado -->
        <TextView
            android:id="@+id/title_slogan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Somos tu mejor maestro"
            android:textAlignment="center"
            android:textColor="#64B5F6"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toTopOf="@id/text_detail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_intro" />

        <!-- Texto detalle -->
        <TextView
            android:id="@+id/text_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Te ayudaremos a mejorar tu capacidad de aprendizaje un 200%"
            android:textAlignment="center"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toTopOf="@id/button_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_slogan" />

        <!-- Botón -->
        <Button
            android:id="@+id/button_start"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:backgroundTint="#7E57C2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="¡EMPIEZA YA A SER PRODUCTIVO!"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_detail"
            app:layout_constraintVertical_bias="0.2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>