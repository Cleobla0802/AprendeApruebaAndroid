<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AprendeAprueba" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#A020F0</item>
        <item name="colorSurface">#2B2B2B</item> <item name="colorOnSurface">@android:color/white</item>
        <item name="colorPrimaryVariant">#7B1FA2</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.MaterialComponents.Subtitle1</item>
        <item name="listPopupWindowStyle">@style/Widget.Material3.PopupMenu.ListPopupWindow</item>
    </style>

    <style name="SpinnerCustomStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:backgroundTint">@android:color/white</item>
    </style>

    <style name="SpinnerPopupStyle" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:background">#1C1B1F</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">
            50%
        </item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="App.NavSubheader" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">#A020F0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.App.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="subheaderTextAppearance">@style/App.NavSubheader</item>
    </style>


</resources>